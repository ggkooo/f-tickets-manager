VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_TICKETS_PATH=/tickets
VITE_USERS_PATH=/users
VITE_REGISTER_PATH=/register
VITE_REPORT_PDF_PATH=/reports/attendances
VITE_TV_RECENTLY_CALLED_PATH=/tickets/recently-called
VITE_API_KEY=your-api-key-here
VITE_API_TIMEOUT_MS=10000
# Must match the backend's REVERB_APP_KEY — powers realtime ticket updates
# (TV/attendant screens). The socket connects to the same host/port as
# VITE_API_BASE_URL, so there's nothing else to configure here.
VITE_REVERB_APP_KEY=your-reverb-app-key-here
